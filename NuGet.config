<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Isolate this repo from any machine-wide/private NuGet feeds (e.g. an internal Lifecare
         feed configured in %AppData%\NuGet\NuGet.Config) - OpenAgentOrchestrator is a standalone
         hackathon project and must only ever resolve packages from the public nuget.org feed. -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
